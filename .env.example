# Environment Variables — The Global Tech Server Rack
# Copy this file to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Dodo Payments
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_payments_webhook_key

# Slot #1 Master Node product ID (create in Dodo dashboard)
DODO_SLOT1_PRODUCT_ID=your_slot1_product_id
# Slots #2-12 product ID
DODO_BLADE_PRODUCT_ID=your_blade_product_id

# Site
NEXT_PUBLIC_SITE_URL=https://serverrack.lol
